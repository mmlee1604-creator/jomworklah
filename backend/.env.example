# Backend runtime settings
PORT=8787
DB_PATH=./data/jomworklah.db
FRONTEND_ORIGIN=http://localhost:8080
ALLOW_DEV_RESET=1

# Resume OCR and structured extraction (PDF/DOCX).
# Set your backend-only key; an empty key uses sample data in auto mode.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Course catalogue (Supabase). Server-side only: use the Secret / service_role key, never in the frontend.
# Without these the API serves only 10 illustrative sample courses.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# CATALOGUE_REFRESH_MS=600000

# Optional OCR limits, timeouts and other settings use defaults from src/config.js.
# See README.md for available overrides.
