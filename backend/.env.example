PORT=8787
DB_PATH=./data/jomworklah.db
FRONTEND_ORIGIN=http://localhost:8080
# Serve the prototype from this API (path is resolved from backend/).
# In this repo the prototype lives two levels up:
# STATIC_DIR=../../jomworklah-temp

# Intelligence provider: "rule" (default, offline) or "openai"
AI_PROVIDER=rule
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=
AI_TIMEOUT_MS=8000

# Guard for POST /api/dev/reset
ALLOW_DEV_RESET=1

# Optional per-IP rate limiting
RATE_LIMIT=0
RATE_LIMIT_PER_MINUTE=120

# Resume OCR + structured extraction for POST /api/parse-resume (PDF and DOCX).
# Obtain a key from https://platform.deepseek.com/ and keep it on the backend.
# Without a key, mode=auto returns sample data flagged is_simulated=true.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Text model used AFTER OCR to produce the existing structured resume JSON.
DEEPSEEK_MODEL=deepseek-flash
# OCR endpoint selects the OCR model itself; there is no OCR model parameter.
DEEPSEEK_OCR_PURPOSE=text_recognition
DEEPSEEK_OCR_TIMEOUT_MS=180000
DEEPSEEK_TIMEOUT_MS=60000
# Reject oversized OCR text instead of silently truncating the resume.
DEEPSEEK_MAX_TEXT_CHARS=120000

# Resume upload limit in bytes (10 MB).
RESUME_MAX_BYTES=10485760
