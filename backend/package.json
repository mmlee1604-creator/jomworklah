{
  "name": "jomworklah-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Jom Kerja Lah backend — skills-to-career navigator API",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "db:migrate": "node --env-file-if-exists=.env scripts/db-migrate.js",
    "db:seed": "node --env-file-if-exists=.env scripts/db-seed.js",
    "db:reset": "node --env-file-if-exists=.env scripts/db-reset.js",
    "supabase:seed:generate": "node scripts/generate-supabase-seed.mjs",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.2",
    "express": "^5.0.0",
    "pg": "^8.23.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "exceljs": "^4.4.0"
  }
}
